## APPLICATION
# streamable-http (default) or stdio; `uv run start --transport stdio` overrides it.
TRANSPORT=streamable-http
PORT=3000
HOST=0.0.0.0
RELOAD=true

## DATABASE
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_PASSWORD=
DATABASE_DB=app
DATABASE_USERNAME=root

## AUTH GUARD (streamable-http only)
API_KEY=
# Externally reachable base URL for OAuth resource metadata (empty = derive from request)
PUBLIC_URL=

## DATABASE POOL (optional, defaults shown)
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800
DATABASE_CONNECT_TIMEOUT=10
DATABASE_STATEMENT_TIMEOUT_MS=30000
DATABASE_ECHO=false

## TOOLS (optional, defaults shown)
QUERY_MAX_ROWS=1000
QUERY_MAX_LENGTH=100000

## DEBUG (optional, defaults shown)
# Log every MCP call to stderr: client IP, tool/resource/prompt, inputs, result and duration.
DEBUG_LOG_REQUESTS=false
# Truncate each logged input/result to N characters (0 = no limit).
DEBUG_LOG_MAX_CHARS=4000

## TOOL FILTERING (optional, comma-separated; empty = everything)
# Groups: server, catalog, query. Tools use full names, e.g. TOOLS_EXCLUDE=query_execute.
# server_discover_tools is always exposed.
TOOL_GROUPS=
TOOLS_INCLUDE=
TOOLS_EXCLUDE=
